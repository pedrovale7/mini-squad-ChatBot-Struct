vector_store/
*.db

# ===== LOGS =====
*.log
logs/

# ===== DEPENDENCY LOCK FILES =====
poetry.lock
uv.lock

# ===== OS FILES =====
.DS_Store
Thumbs.db
*.ini

# ===== SECRETS =====
secrets.json
credentials.json

