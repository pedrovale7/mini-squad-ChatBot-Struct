chroma_db/
data/

# ===== AMBIENTES VIRTUAIS =====
venv/
.venv/
env/
ENV/
*.egg-info/
dist/
build/

# ===== VARIÁVEIS DE AMBIENTE (SEGURANÇA!) =====
.env
.env.local
.env.*.local

# ===== CACHE PYTHON =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/

# ===== IDE & EDITORS =====
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

# ===== JUPYTER NOTEBOOKS =====
.ipynb_checkpoints/
*.ipynb

# ===== DADOS & MODELOS =====
data/raw/
data/processed/
*.pkl
*.pickle
*.model
faiss_index/
*.index

# ===== VECTOR DATABASES =====
